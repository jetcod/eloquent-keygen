{
    "name": "jetcod/eloquent-keygen",
    "description": "A Laravel package providing seamless integration with Snowflake ID generation for Eloquent models",
    "keywords": [
        "laravel",
        "eloquent",
        "snowflake",
        "unique id",
        "primary key",
        "model",
        "generator",
        "automatic id",
        "distributed systems"
    ],
    "type": "library",
    "require": {
        "php-64bit": ">=8.1",
        "godruoyi/php-snowflake": "^3.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.49",
        "phpstan/phpstan": "^2.2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
        "orchestra/testbench": "^10.0|^11.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jetcod\\Eloquent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jetcod\\Eloquent\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Hamid Ghorashi",
            "email": "h.ghorashi@gmail.com"
        }
    ],
    "scripts": {
        "phpcs-fix": "./vendor/bin/php-cs-fixer fix ",
        "phpstan": "./vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=-1 src/",
        "test": "./vendor/bin/phpunit --testdox "
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jetcod\\Eloquent\\ServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
